{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/audio/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/download", "destination": "https://dl.zhangxiaocai.cn/mixnotice/MixNotice-v1.0.0-fix10-arm64-debug.apk", "permanent": false },
    { "source": "/apk", "destination": "https://dl.zhangxiaocai.cn/mixnotice/MixNotice-v1.0.0-fix10-arm64-debug.apk", "permanent": false }
  ]
}
